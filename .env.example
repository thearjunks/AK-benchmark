GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key
SMTP_USER=your_gmail_address
SMTP_APP_PASSWORD=your_gmail_app_password
EMAIL_RECIPIENTS=recipient.one@example.com,recipient.two@example.com
REPORT_TIME=15:00
AUTO_SEND_AFTER_CHECK=true
ADMIN_EMAIL=admin@stc.com.kw
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password
PUBLIC_APP_URL=https://bench.stcdigitalhub.com
# GitHub Actions fallback for sites that PageSpeed cannot render:
GITHUB_ACTIONS_TOKEN=github_fine_grained_token_with_actions_write
LIGHTHOUSE_CALLBACK_TOKEN=generate_a_long_random_shared_secret
LIGHTHOUSE_WORKER_REPOSITORY=thearjunks/AK-benchmark
LIGHTHOUSE_WORKER_REF=main
# Set false only for local automated testing; production should remain true.
ACCESS_EMAIL_NOTIFICATIONS=true
# Enable only for intentionally public static demo exports:
STATIC_SNAPSHOT_EXPORT=false
# Optional persistent runtime directory override:
# BENCHMARK_DATA_DIR=/home/account/.webpulse-benchmark
